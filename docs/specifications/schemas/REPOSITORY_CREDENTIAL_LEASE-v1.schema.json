{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryCredentialLeaseV1",
  "description": "Defines temporary transport capability via a broker reference. Does NOT contain raw secrets or grant sovereign authority.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "REPOSITORY_CREDENTIAL_LEASE-v1"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^cred_lease_[a-zA-Z0-9_-]+$"
    },
    "credential_capability_id": {
      "type": "string",
      "pattern": "^cred_cap_[a-zA-Z0-9_-]+$"
    },
    "authorized_use_reference": {
      "type": "string",
      "pattern": "^pub_auth_[a-zA-Z0-9_-]+$",
      "description": "Binds the lease strictly to a specific authorization instance."
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "MUST equal canonical_remote_identity.provider during semantic validation."
    },
    "principal_identity": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "principal_type": {
          "type": "string",
          "enum": [
            "github_app_installation",
            "oauth_client",
            "scoped_user_token"
          ]
        },
        "principal_id": { "type": "string", "minLength": 1 }
      },
      "required": ["provider", "principal_type", "principal_id"],
      "additionalProperties": false
    },
    "temporal_bounds": {
      "type": "object",
      "properties": {
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "required": ["issued_at", "expires_at"],
      "additionalProperties": false
    },
    "consumption_policy": {
      "type": "object",
      "properties": {
        "single_use_only": { "type": "boolean", "const": true }
      },
      "required": ["single_use_only"],
      "additionalProperties": false
    },
    "broker_reference": {
      "type": "string",
      "pattern": "^broker_ref_[a-zA-Z0-9_-]+$"
    },
    "technical_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "contents:read",
          "contents:write",
          "metadata:read"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "lease_id",
    "credential_capability_id",
    "authorized_use_reference",
    "provider",
    "principal_identity",
    "temporal_bounds",
    "consumption_policy",
    "broker_reference",
    "technical_scope"
  ],
  "additionalProperties": false
}
