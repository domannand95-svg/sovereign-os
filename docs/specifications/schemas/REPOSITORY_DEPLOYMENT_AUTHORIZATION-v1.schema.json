{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryDeploymentAuthorizationV1",
  "description": "Defines bounded permission to execute one immutable deployment candidate.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "REPOSITORY_DEPLOYMENT_AUTHORIZATION-v1"
    },
    "deployment_authorization_id": {
      "type": "string",
      "pattern": "^dep_auth_[a-zA-Z0-9_-]+$"
    },
    "deployment_candidate_ref": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^dep_cand_[a-zA-Z0-9_-]+$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": ["candidate_id", "artifact_digest"],
      "additionalProperties": false
    },
    "runtime_binding": {
      "type": "object",
      "properties": {
        "runtime_id": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        }
      },
      "required": ["runtime_id", "environment"],
      "additionalProperties": false
    },
    "authorized_scope": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "repository.runtime.deploy_exact"
        },
        "rollback_permitted": {
          "type": "boolean",
          "const": false
        },
        "secret_rotation_permitted": {
          "type": "boolean",
          "const": false
        },
        "infra_admin": {
          "type": "boolean",
          "const": false
        },
        "production_override": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "operation",
        "rollback_permitted",
        "secret_rotation_permitted",
        "infra_admin",
        "production_override"
      ],
      "additionalProperties": false
    },
    "temporal_bounds": {
      "type": "object",
      "properties": {
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["issued_at", "expires_at"],
      "additionalProperties": false
    },
    "consumption_policy": {
      "type": "object",
      "properties": {
        "single_use_only": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["single_use_only"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "deployment_authorization_id",
    "deployment_candidate_ref",
    "runtime_binding",
    "authorized_scope",
    "temporal_bounds",
    "consumption_policy"
  ],
  "additionalProperties": false
}
