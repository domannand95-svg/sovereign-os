{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryPullRequestAuthorizationV1",
  "description": "Defines bounded permission to create one exact pull request candidate. Does NOT grant review, approval, merge, or repository mutation authority.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "REPOSITORY_PULL_REQUEST_AUTHORIZATION-v1"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^pr_auth_[a-zA-Z0-9_-]+$"
    },
    "candidate_binding": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^pr_cand_[a-zA-Z0-9_-]+$"
        },
        "source_commit_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "candidate_id",
        "source_commit_oid"
      ],
      "additionalProperties": false
    },
    "target_binding": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "pattern": "^refs/heads/[a-zA-Z0-9_/-]+$"
        }
      },
      "required": [
        "repository_id",
        "target_ref"
      ],
      "additionalProperties": false
    },
    "temporal_bounds": {
      "type": "object",
      "properties": {
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "issued_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "authorized_scope": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "repository.remote.create_pull_request"
        },
        "review_permitted": {
          "type": "boolean",
          "const": false
        },
        "approval_permitted": {
          "type": "boolean",
          "const": false
        },
        "merge_permitted": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "operation",
        "review_permitted",
        "approval_permitted",
        "merge_permitted"
      ],
      "additionalProperties": false
    },
    "consumption_policy": {
      "type": "object",
      "properties": {
        "single_use_only": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "single_use_only"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "authorization_id",
    "candidate_binding",
    "target_binding",
    "temporal_bounds",
    "authorized_scope",
    "consumption_policy"
  ],
  "additionalProperties": false
}
