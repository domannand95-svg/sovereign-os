{
  "": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryMutationVerificationResultV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "REPOSITORY_MUTATION_VERIFICATION_RESULT-v1"
    },
    "verification_id": {
      "type": "string",
      "pattern": "^ver_[a-zA-Z0-9_-]+$"
    },
    "mutation_reference": {
      "type": "string",
      "minLength": 1
    },
    "repository_reference": {
      "type": "string",
      "minLength": 1
    },
    "candidate_reference": {
      "type": "string",
      "minLength": 1
    },
    "expected_target_paths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "observed_target_paths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expected_delta_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16,64}$"
    },
    "observed_delta_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16,64}$"
    },
    "verification_disposition": {
      "type": "string",
      "enum": ["VERIFIED", "MISMATCH", "INCOMPLETE"]
    },
    "verification_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "verification_id",
    "mutation_reference",
    "repository_reference",
    "candidate_reference",
    "expected_target_paths",
    "observed_target_paths",
    "expected_delta_digest",
    "observed_delta_digest",
    "verification_disposition",
    "verification_reasons",
    "checked_at"
  ],
  "additionalProperties": false
}
