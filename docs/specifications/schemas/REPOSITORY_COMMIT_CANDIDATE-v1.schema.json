{
  "": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryCommitCandidateV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "REPOSITORY_COMMIT_CANDIDATE-v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand_commit_[a-zA-Z0-9_-]+$"
    },
    "repository_reference": {
      "type": "string",
      "minLength": 1
    },
    "stage_verification_reference": {
      "type": "string",
      "minLength": 1
    },
    "tree_reference": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16,64}$"
    },
    "parent_commit": {
      "type": "string",
      "minLength": 1
    },
    "author_identity": {
      "type": "string",
      "minLength": 1
    },
    "author_timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "committer_identity": {
      "type": "string",
      "minLength": 1
    },
    "committer_timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "candidate_commit_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16,64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "repository_reference",
    "stage_verification_reference",
    "tree_reference",
    "parent_commit",
    "author_identity",
    "author_timestamp",
    "committer_identity",
    "committer_timestamp",
    "message",
    "candidate_commit_digest",
    "created_at"
  ],
  "additionalProperties": false
}
