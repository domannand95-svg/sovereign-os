{
  "": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryCommitVerificationResultV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "REPOSITORY_COMMIT_VERIFICATION_RESULT-v1"
    },
    "verification_id": {
      "type": "string",
      "pattern": "^ver_commit_[a-zA-Z0-9_-]+$"
    },
    "construction_result_reference": {
      "type": "string",
      "minLength": 1
    },
    "candidate_reference": {
      "type": "string",
      "minLength": 1
    },
    "repository_reference": {
      "type": "string",
      "minLength": 1
    },
    "expected_commit_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16,64}$"
    },
    "observed_commit_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16,64}$"
    },
    "verification_disposition": {
      "type": "string",
      "enum": ["VERIFIED", "MISMATCH", "INCOMPLETE", "UNKNOWN"]
    },
    "verification_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "verification_id",
    "construction_result_reference",
    "candidate_reference",
    "repository_reference",
    "expected_commit_id",
    "observed_commit_id",
    "verification_disposition",
    "verification_reasons",
    "checked_at"
  ],
  "additionalProperties": false
}
