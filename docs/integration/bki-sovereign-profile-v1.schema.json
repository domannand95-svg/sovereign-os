{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/domannand95-svg/knowledge-infrastructure-bootstrap-kit/blob/main/docs/integration/bki-sovereign-profile-v1.schema.json",
  "title": "BKI and Sovereign OS Metadata Compatibility Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "document_id",
    "version",
    "status",
    "last_revised"
  ],
  "properties": {
    "profile_version": {
      "const": "bki.sovereign.profile.v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value"],
      "properties": {
        "namespace": {
          "enum": ["bki", "sovereign"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "last_revised": {
      "type": "string",
      "format": "date"
    }
  }
}
